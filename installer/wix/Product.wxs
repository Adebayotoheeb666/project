<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:firewall="http://schemas.microsoft.com/wix/FirewallExtension">

  <Product Id="*"
           Name="LSIA School Computer"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="Local-First School Intelligence System"
           UpgradeCode="B9206A82-C25F-4E38-9588-75E26E518BA9">

    <Package InstallerVersion="301"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Local-First School Intelligence System (LSIA) School Computer Server and Administration Desk"
             Comments="Privacy-focused local school register. Operates offline without external cloud dependencies." />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPHELPLINK" Value="http://127.0.0.1:8080" />
    <Property Id="ARPURLINFOABOUT" Value="http://127.0.0.1:8080" />

    <!-- Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="LSIA School Computer">
          <Directory Id="SERVERFOLDER" Name="server" />
          <Directory Id="ADMINFOLDER" Name="admin">
            <Directory Id="ADMINDISTFOLDER" Name="dist" />
          </Directory>

          <Component Id="MainBatchComponent" Guid="E6134D09-3221-4A55-9B21-817E19293411">
            <File Id="StartScript" Source="$(var.RepoRoot)\scripts\start-school-computer.bat" KeyPath="yes" />
            <File Id="StartPsScript" Source="$(var.RepoRoot)\scripts\start-school-computer.ps1" />
            <File Id="ReadmeFile" Source="$(var.RepoRoot)\README.md" />
            
            <!-- Firewall Exception for School LAN Synchronization on port 8080 -->
            <firewall:FirewallException Id="LSIAFirewallPort8080"
                                        Name="LSIA School Server"
                                        Port="8080"
                                        Protocol="tcp"
                                        Scope="localSubnet"
                                        IgnoreFailure="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="LSIA School Computer">
          <Component Id="ApplicationShortcut" Guid="738F6A3B-1B44-4BC9-9A77-386057EE1977">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="LSIA School Computer"
                      Description="Launch LSIA School Computer and Administration Desk"
                      Target="[INSTALLFOLDER]start-school-computer.bat"
                      WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="OpenBrowserShortcut"
                      Name="LSIA Web Register"
                      Description="Open LSIA in default browser"
                      Target="[SystemFolder]rundll32.exe"
                      Arguments="url.dll,FileProtocolHandler http://127.0.0.1:8080" />
            <Shortcut Id="UninstallProductShortcut"
                      Name="Uninstall LSIA School Computer"
                      Description="Uninstall LSIA School Computer"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]" />
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\LSIA\SchoolComputer" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Desktop Shortcut -->
      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="ApplicationDesktopShortcut" Guid="418CA00E-6691-4475-BC41-572E153D4632">
          <Shortcut Id="DesktopStartShortcut"
                    Name="LSIA School Computer"
                    Description="Launch LSIA School Computer"
                    Target="[INSTALLFOLDER]start-school-computer.bat"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\LSIA\SchoolComputer" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <!-- Features -->
    <Feature Id="MainProduct" Title="LSIA School Computer" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="MainBatchComponent" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
      <ComponentGroupRef Id="ServerFilesGroup" />
      <ComponentGroupRef Id="AdminFilesGroup" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    </UI>

  </Product>
</Wix>
